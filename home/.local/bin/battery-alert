#!/bin/sh
# Run every 2 min by battery-alert.timer. Warns once at 15% and once at 7%
# per discharge; resets when the charger is plugged in.
bat=/sys/class/power_supply/BAT0
state="${XDG_RUNTIME_DIR:-/tmp}/battery-alert.state"
cap=$(cat "$bat/capacity"); status=$(cat "$bat/status")
last=$(cat "$state" 2>/dev/null || echo 100)

if [ "$status" != Discharging ]; then
    echo 100 > "$state"; exit 0
fi
if [ "$cap" -le 7 ] && [ "$last" -gt 7 ]; then
    notify-send -a battery -u critical -i battery-caution "Battery critically low: $cap%" "Plug in the charger now."
    echo 7 > "$state"
elif [ "$cap" -le 15 ] && [ "$last" -gt 15 ]; then
    notify-send -a battery -u normal -i battery-low "Battery low: $cap%" "Plug in the charger soon."
    echo 15 > "$state"
fi
