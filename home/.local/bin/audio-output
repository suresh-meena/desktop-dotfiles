#!/bin/sh
# Toggle sound between the laptop (speakers/headphones) and the monitor (HDMI).
# The microphone stays on the laptop either way.
card=alsa_card.pci-0000_00_1f.3
laptop=output:analog-stereo+input:analog-stereo
monitor=output:hdmi-stereo+input:analog-stereo

current=$(pactl list cards | awk -v c="$card" '$1=="Name:" {n=$2} n==c && /Active Profile:/ {print $3}')

if [ "$current" = "$monitor" ] || [ "${1:-}" = laptop ]; then
    pactl set-card-profile "$card" "$laptop" && where="Laptop speakers"
else
    if ! grep -q 'monitor_present\s*1' /proc/asound/card0/eld#2.0 2>/dev/null; then
        notify-send -a osd -u low -t 2000 -h string:x-dunst-stack-tag:osd "󰓃  No monitor with sound connected"
        exit 1
    fi
    pactl set-card-profile "$card" "$monitor" && where="Monitor (HDMI)"
fi
notify-send -a osd -u low -t 1500 -h string:x-dunst-stack-tag:osd "󰓃  Sound: $where"
