# Palette: Gruvbox dark, muted
[global]
    monitor = 0
    follow = mouse
    width = (0, 340)
    origin = top-right
    offset = (8, 40)
    gap_size = 4
    padding = 8
    horizontal_padding = 10
    frame_width = 1
    corner_radius = 10
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 40
    indicate_hidden = yes
    show_age_threshold = -1
    sort = yes
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282828db"
    foreground = "#a89984"
    frame_color = "#3c3836"
    timeout = 5

[urgency_normal]
    background = "#282828db"
    foreground = "#d5c4a1"
    frame_color = "#7c6f64"
    timeout = 8

[urgency_critical]
    background = "#282828db"
    foreground = "#d5c4a1"
    frame_color = "#cc241d"
    timeout = 0
