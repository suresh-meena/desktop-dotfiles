# Gruvbox dark, muted — matches Waybar / kitty / dunst / fuzzel / zathura
theme[main_bg]="#282828"
theme[main_fg]="#d5c4a1"
theme[title]="#d5c4a1"
theme[hi_fg]="#d79921"
theme[selected_bg]="#3c3836"
theme[selected_fg]="#d79921"
theme[inactive_fg]="#665c54"
theme[graph_text]="#a89984"
theme[meter_bg]="#3c3836"
theme[proc_misc]="#689d6a"

# box outlines
theme[cpu_box]="#504945"
theme[mem_box]="#504945"
theme[net_box]="#504945"
theme[proc_box]="#504945"
theme[div_line]="#3c3836"

# gradients: calm green -> yellow -> muted red
